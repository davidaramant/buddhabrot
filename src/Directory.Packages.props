<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="Avalonia" Version="12.1.6" />
		<PackageVersion Include="Avalonia.Controls.ItemsRepeater" Version="12.0.0" />
		<PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
		<PackageVersion Include="Avalonia.Diagnostics" Version="11.3.23" />
		<PackageVersion Include="Avalonia.ReactiveUI" Version="11.3.8" />
		<PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
		<PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
		<PackageVersion Include="CacheTable.Net" Version="0.1.43" />
		<PackageVersion Include="CliWrap" Version="3.10.5" />
		<PackageVersion Include="Colourful" Version="3.2.0" />
		<PackageVersion Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
		<PackageVersion Include="coverlet.collector" Version="10.1.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageVersion>
		<PackageVersion Include="Hardware.Info" Version="110.0.0.1" />
		<PackageVersion Include="Humanizer.Core" Version="3.0.10" />
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
		<PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
		<PackageVersion Include="NUnit" Version="5.0.0" />
		<PackageVersion Include="NUnit.Analyzers" Version="4.15.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageVersion>
		<PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
		<PackageVersion Include="protobuf-net" Version="3.4.40" />
		<PackageVersion Include="Serilog" Version="4.4.0" />
		<PackageVersion Include="Serilog.Extensions.Logging" Version="11.0.0" />
		<PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageVersion Include="Shouldly" Version="4.3.0" />
		<PackageVersion Include="SkiaSharp" Version="4.157.0" />
		<PackageVersion Include="Spectre.Console" Version="0.57.2" />
		<PackageVersion Include="System.CommandLine.DragonFruit" Version="0.4.0-alpha.25306.1" />
		<PackageVersion Include="Tedd.MortonEncoding" Version="1.1.28" />
		<PackageVersion Include="XamlNameReferenceGenerator" Version="1.6.1" />
		<PackageVersion Include="xunit" Version="2.9.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageVersion>
	</ItemGroup>
</Project>
